# ============================================================
# Variables de entorno requeridas para CarbonHub Backend
# Copiar este archivo como .env y completar con valores reales.
# NUNCA subir el archivo .env al repositorio.
# ============================================================

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/carbonhub
DB_USER=carbonhub
DB_PASSWORD=cambiala_por_una_larga_y_aleatoria

# Google OAuth (OpenID Connect)
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT
JWT_SECRET=your_jwt_secret_here_base64_min_256_bits
JWT_EXPIRATION=3600000

# Google Gemini (Spring AI) — requerido para interpretación IA del IMA
GEMINI_API_KEY=your_gemini_api_key_here

# Climatiq (factores de emisión)
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# Email (notificaciones — Gmail SMTP)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
APP_EMAIL_PROVIDER=gmail

# Uploads
UPLOAD_DIR=./uploads

# Frontend URLs
FRONTEND_VERIFICAR_CORREO_URL=http://localhost:4200/verificar-correo
FRONTEND_INVITACION_URL=http://localhost:4200/registro/invitacion
FRONTEND_RESET_CONTRASENA_URL=http://localhost:4200/reset-contrasena
FRONTEND_LOGIN_URL=http://localhost:4200/login
FRONTEND_CERTIFICACION_DETALLE_URL=http://localhost:4200/empresa/{slug}/reputacion/certificaciones
FRONTEND_BASE_URL=http://localhost:4200
FRONTEND_ALLOWED_LINK_HOSTS=localhost,127.0.0.1

# Limite de abuso de invitaciones por empresa
INVITACION_MAX_EMISIONES_POR_HORA=20

# Emision de credenciales OpenBadges 3.0 (certificaciones e insignias)
# Usar una clave RSA PKCS#8 privada. NUNCA subir la clave real al repositorio.
CERTIFICACIONES_URL_BASE=http://localhost:8080
CERTIFICACIONES_EMISOR_NOMBRE=CarbonHub
CERTIFICACIONES_CLAVE_ID=carbonhub-emision-local-1
CERTIFICACIONES_CLAVE_PRIVADA_PEM=-----BEGIN PRIVATE KEY-----base64_de_la_clave-----END PRIVATE KEY-----
